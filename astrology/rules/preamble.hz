# A sign of the zodiac: the ecliptic, the Sun's yearly path, in twelve parts of 30 degrees each, Aries first from the March equinox #
type Sign = + Aries + Taurus + Gemini + Cancer + Leo + Virgo + Libra + Scorpio + Sagittarius + Capricorn + Aquarius + Pisces in
# A sign's element and its modality #
type Element = + Fire + Earth + Air + Water in
type Modality = + Cardinal + Fixed + Mutable in
# The bodies a chart places: the two lights, the five planets seen by eye, and the three found since #
type Body = + Sun + Moon + Mercury + Venus + Mars + Jupiter + Saturn + Uranus + Neptune + Pluto in
# Where a body stands: its ecliptic longitude, in degrees from the start of Aries #
type Place = (body = Body, longitude = Float) in
# The five major aspects, named by the angle between two bodies #
type Kind = + Conjunction + Sextile + Square + Trine + Opposition in
# Two bodies in aspect, and how far the angle between them is from exact, in degrees #
type Aspect = (a = Body, b = Body, kind = Kind, orb = Float) in
# A moment, as the page gives it: the date, and the hour in Universal Time #
type Moment = (year = Int, month = Int, day = Int, hour = Float) in
# A place on Earth: latitude, north positive, and longitude, east positive, in degrees #
type Site = (latitude = Float, longitude = Float) in
# A chart's two angles, and the first degree of each of its twelve houses #
type Chart = (ascendant = Float, midheaven = Float, houses = [Float]) in

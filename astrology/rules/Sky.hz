# The planets' mean orbital elements of date, each a polynomial in Julian centuries from J2000.0: mean longitude, semi-major axis (AU), eccentricity, inclination, ascending node, longitude of perihelion (degrees) (Meeus Table 31.A, from astronomia's src/planetelements.js) #
let elements : Body -> ([Float], [Float], [Float], [Float], [Float], [Float]) = fun b ->
  case b
  | Mercury => ([252.250906, 149474.0722491, 0.0003035, 0.000000018], [0.38709831], [0.20563175, 0.000020407, -0.0000000283, -0.00000000018], [7.004986, 0.0018215, -0.0000181, 0.000000056], [48.330893, 1.1861883, 0.00017542, 0.000000215], [77.456119, 1.5564776, 0.00029544, 0.000000009])
  | Venus => ([181.979801, 58519.2130302, 0.00031014, 0.000000015], [0.72332982], [0.00677192, -0.000047765, 0.0000000981, 0.00000000046], [3.394662, 0.0010037, -0.00000088, -0.000000007], [76.67992, 0.9011206, 0.00040618, -0.000000093], [131.563703, 1.4022288, -0.00107618, -0.000005678])
  | Sun => ([100.466457, 36000.7698278, 0.00030322, 0.00000002], [1.000001018], [0.01670863, -0.000042037, -0.0000001267, 0.00000000014], [0.], [0.], [102.937348, 1.7195366, 0.00045688, -0.000000018])
  | Mars => ([355.433, 19141.6964471, 0.00031052, 0.000000016], [1.523679342], [0.09340065, 0.000090484, -0.0000000806, -0.00000000025], [1.849726, -0.0006011, 0.00001276, -0.000000007], [49.558093, 0.7720959, 0.00001557, 0.000002267], [336.060234, 1.8410449, 0.00013477, 0.000000536])
  | Jupiter => ([34.351519, 3036.3027748, 0.0002233, 0.000000037], [5.202603209, 0.0000001913], [0.04849793, 0.000163225, -0.0000004714, -0.00000000201], [1.303267, -0.0054965, 0.00000466, -0.000000002], [100.464407, 1.0209774, 0.00040315, 0.000000404], [14.331207, 1.6126352, 0.00103042, -0.000004464])
  | Saturn => ([50.077444, 1223.5110686, 0.00051908, -0.00000003], [9.554909192, -0.000002139, 0.000000004], [0.05554814, -0.000346641, -0.0000006436, 0.0000000034], [2.488879, -0.0037362, -0.00001519, 0.000000087], [113.665503, 0.877088, -0.00012176, -0.000002249], [93.057237, 1.9637613, 0.00083753, 0.000004928])
  | Uranus => ([314.055005, 429.8640561, 0.0003039, 0.000000026], [19.218446062, -0.0000000372, 0.00000000098], [0.04638122, -0.000027293, 0.0000000789, 0.00000000024], [0.773197, 0.0007744, 0.00003749, -0.000000092], [74.005957, 0.5211278, 0.00133947, 0.000018484], [173.005291, 1.486379, 0.00021406, 0.000000434])
  | Neptune => ([304.348665, 219.8833092, 0.00030882, 0.000000018], [30.110386869, -0.0000001663, 0.00000000069], [0.00945575, 0.000006033, 0., -0.00000000005], [1.769953, -0.0093082, -0.00000708, 0.000000027], [131.784057, 1.1022039, 0.00025952, -0.000000637], [48.120276, 1.4262957, 0.00038434, 0.00000002])
  | _ => ([0.], [0.], [0.], [0.], [0.], [0.])
  end;
# ---- end of tables #
# A polynomial in t, its coefficients from the constant up (Horner's rule) #
let poly : ([Float], Float) -> Float = fun (cs, t) ->
  case cs | [] => 0. | c :: rest => c +. t *. poly(rest, t) end;
# The nutation in longitude, in degrees: the wobble of the Earth's axis that shifts the equinox (Meeus 22, its four largest terms) #
let nutation : Float -> Float = fun t ->
  let om = Chart.rad(125.04452 -. 1934.136261 *. t) in
  let l = Chart.rad(280.4665 +. 36000.7698 *. t) in
  let l2 = Chart.rad(218.3165 +. 481267.8813 *. t) in
  (0. -. 17.2 *. sin(om) -. 1.32 *. sin(2. *. l) -. 0.23 *. sin(2. *. l2) +. 0.21 *. sin(2. *. om)) /. 3600.;
# The Sun's apparent longitude, nutation and aberration included (Meeus 25.2 to 25.8, astronomia's solar.apparentLongitude) #
let sun : Float -> Float = fun t ->
  let m = Chart.rad(poly([357.52911, 35999.05029, -0.0001537], t)) in
  let c = poly([1.914602, -0.004817, -0.000014], t) *. sin(m) +. (0.019993 -. 0.000101 *. t) *. sin(2. *. m) +. 0.000289 *. sin(3. *. m) in
  Zodiac.normalize(poly([280.46646, 36000.76983, 0.0003032], t) +. c -. 0.00569 -. 0.00478 *. sin(Chart.rad(125.04 -. 1934.136 *. t)));
# The Moon's terms summed: a term with the Sun's anomaly M is reduced by the Earth's eccentricity, E or E squared #
let moon_sum : ([(Int, Int, Int, Int, Float)], Float, Float, Float, Float, Float) -> Float = fun (ts, d, m, mp, f, e) ->
  case ts
  | [] => 0.
  | (a, b, c, k, coef) :: rest =>
    let factor = if b == 0 then 1. else if b == 1 || b == 0 - 1 then e else e *. e in
    coef *. factor *. sin(float_of_int(a) *. d +. float_of_int(b) *. m +. float_of_int(c) *. mp +. float_of_int(k) *. f)
      +. moon_sum(rest, d, m, mp, f, e)
  end;
# The Moon's apparent longitude (Meeus 47, astronomia's moonposition.position, with the nutation) #
let moon : Float -> Float = fun t ->
  let lp = poly([218.3164477, 481267.88123421, -0.0015786, 1. /. 538841., -1. /. 65194000.], t) in
  let d = Chart.rad(poly([297.8501921, 445267.1114034, -0.0018819, 1. /. 545868., -1. /. 113065000.], t)) in
  let m = Chart.rad(poly([357.5291092, 35999.0502909, -0.0001536, 1. /. 24490000.], t)) in
  let mp = Chart.rad(poly([134.9633964, 477198.8675055, 0.0087414, 1. /. 69699., -1. /. 14712000.], t)) in
  let f = Chart.rad(poly([93.272095, 483202.0175233, -0.0036539, -1. /. 3526000., 1. /. 863310000.], t)) in
  let a1 = Chart.rad(119.75 +. 131.849 *. t) in
  let a2 = Chart.rad(53.09 +. 479264.29 *. t) in
  let e = poly([1., -0.002516, -0.0000074], t) in
  let extra = 3958. *. sin(a1) +. 1962. *. sin(Chart.rad(lp) -. f) +. 318. *. sin(a2) in
  Zodiac.normalize(lp +. (moon_sum(moon_terms, d, m, mp, f, e) +. extra) /. 1000000. +. nutation(t));
# Kepler's equation, E - e sin E = M, solved by Newton's method from E = M (radians) #
let kepler : (Float, Float, Float, Int) -> Float = fun (m, e, ea, n) ->
  if n == 0 then ea else kepler(m, e, ea -. (ea -. e *. sin(ea) -. m) /. (1. -. e *. cos(ea)), n - 1);
# A body's place around the Sun, from its elements at t: ecliptic coordinates of date, in AU #
let heliocentric : (Body, Float) -> (Float, Float, Float) = fun (b, t) ->
  let (ls, axes, es, incs, nodes, peris) = elements(b) in
  let (l, a, e, i, node, peri) = (poly(ls, t), poly(axes, t), poly(es, t), poly(incs, t), poly(nodes, t), poly(peris, t)) in
  let ma = Chart.rad(l -. peri) in
  let ea = kepler(ma, e, ma, 8) in
  let xv = a *. (cos(ea) -. e) in
  let yv = a *. sqrt(1. -. e *. e) *. sin(ea) in
  let r = sqrt(xv *. xv +. yv *. yv) in
  let u = Chart.arctan2(yv, xv) +. Chart.rad(peri -. node) in
  let om = Chart.rad(node) in
  let ci = cos(Chart.rad(i)) in
  (r *. (cos(om) *. cos(u) -. sin(om) *. sin(u) *. ci), r *. (sin(om) *. cos(u) +. cos(om) *. sin(u) *. ci), r *. sin(u) *. sin(Chart.rad(i)));
# A planet's longitude as seen from the Earth (the Earth's elements are filed under the Sun's name, above) #
let planet : (Body, Float) -> Float = fun (b, t) ->
  let (x, y, z) = heliocentric(b, t) in
  let (xe, ye, ze) = heliocentric(Sun, t) in
  Zodiac.normalize(Chart.deg(Chart.arctan2(y -. ye, x -. xe)) +. nutation(t));
# Pluto's terms summed, for longitude, latitude or distance #
let pluto_sum : ([(Int, Int, Int, Float, Float, Float, Float, Float, Float)], Float, Float, Float, Int) -> Float = fun (ts, j, s, p, which) ->
  case ts
  | [] => 0.
  | (i, k, n, la, lb, ba, bb, ra, rb) :: rest =>
    let x = Chart.rad(float_of_int(i) *. j +. float_of_int(k) *. s +. float_of_int(n) *. p) in
    let (sa, sb) = if which == 0 then (la, lb) else if which == 1 then (ba, bb) else (ra, rb) in
    sa *. sin(x) +. sb *. cos(x) +. pluto_sum(rest, j, s, p, which)
  end;
# Pluto as seen from the Earth (Meeus 37, astronomia's pluto.heliocentric, for 1885 to 2099): its place around the Sun on the ecliptic of 2000, turned to the date's equinox by the general precession, then less the Earth's #
let pluto : Float -> Float = fun t ->
  let j = 34.35 +. 3034.9057 *. t in
  let s = 50.08 +. 1222.1138 *. t in
  let p = 238.96 +. 144.96 *. t in
  let l = Chart.rad(pluto_sum(pluto_terms, j, s, p, 0) +. 238.958116 +. 144.96 *. t +. (5029.0966 *. t +. 1.11113 *. t *. t) /. 3600.) in
  let b = Chart.rad(pluto_sum(pluto_terms, j, s, p, 1) -. 3.908239) in
  let r = pluto_sum(pluto_terms, j, s, p, 2) +. 40.7241346 in
  let (xe, ye, ze) = heliocentric(Sun, t) in
  Zodiac.normalize(Chart.deg(Chart.arctan2(r *. cos(b) *. sin(l) -. ye, r *. cos(b) *. cos(l) -. xe)) +. nutation(t));
# A body's longitude at a Julian day #
let longitude : (Body, Float) -> Float = fun (b, jd) ->
  let t = Chart.centuries(jd) in
  case b | Sun => sun(t) | Moon => moon(t) | Pluto => pluto(t) | _ => planet(b, t) end;
let bodies : [Body] = [Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto];
let places_of : ([Body], Float) -> [Place] = fun (bs, jd) ->
  case bs | [] => [] | b :: rest => (body = b, longitude = longitude(b, jd)) :: places_of(rest, jd) end;
# Every body's place at a moment #
let places : Moment -> [Place] = fun m -> places_of(bodies, Chart.julian_day(m))

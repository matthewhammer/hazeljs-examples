# The speed run's way, by A* (^ticket(905); ^report(68), What next, step 5: "Find the run's way by A* rather than by searching the whole world from the gnome outward, so a long search does not make a long step"; Matthew, 2026-11-27: "in Hazel"). Its numbers are Floats, under `use Float in` (Matthew, 2026-11-28: "Float, use Float in"): every one a whole number far under 2^53, so exact, and a division the floor of the quotient, exact for whole numbers of that size; compiled, it is JavaScript's own arithmetic. The page hands over a window of the world round the gnome and its target, a number for each tile, row by row; the answer is the way, the tiles from the first step to the target, each as its place in the window (none, no way within the window: the page tries a wider one). Each tile's number: the cost of going into it in thousandths of a step (0, no way in: rock no digger digs, a boulder, outside the window; 1000 open; 1600 shallow water without the diving gear, 40000 deep; digging, 1000 more for each eleven steps of it), times 8; plus 4 where it is ground, 2 where the gnome can climb in it, 1 where it can stand on what is under it. The moves, as the page's search had them: across, from a tile it can hold on to (ground, a climb, a stand); down; up a climb, or into ground over a tile it holds on to, 300 more; up by a jump from a stand, 1500 more, or across and up onto a stand, 1800 more. A* goes nearest-first by the cost so far and a guess of what is left, 1000 for each tile across and down, which is never more than the way costs, so the way found is a cheapest one; among those, the next tile taken is the one with the least estimate and then the least place, so the page's JavaScript twin (wayJS) finds the very same way. Its own types are inside it, as the world's program has as many definitions as the browser lets it build #
let way : ([Float], Float, Float, Float, Float, [Float], Float) -> [Float] = fun (codes, w, h, s, t, avoid, limit) -> use Float in
  type Grid = + GLeaf + GNode(Grid, Float, Grid) in
  type Best = + BLeaf + BNode(Best, Float, Float, Float, Best, Float) in
  type Heap = + HE + HN(Float, Float, Float, [Heap]) in
  let md : (Float, Float) -> Float = fun (a, b) -> a - floor(a / b) * b in
  let n = w * h in
  # the window's tiles as a tree balanced by halves, made once: a tile by its place in log time #
  let build : (Float, [Float]) -> (t = Grid, rest = [Float]) = fun (k, xs) ->
    if k <= 0 then (t = GLeaf, rest = xs)
    else (let kl = floor(k / 2) in let left = build(kl, xs) in
      case left.rest
      | [] => (t = left.t, rest = [])
      | x :: more => (let right = build(k - kl - 1, more) in (t = GNode(left.t, x, right.t), rest = right.rest))
      end) in
  let grid = build(n, codes).t in
  let get : (Grid, Float, Float) -> Float = fun (g, i, k) ->
    case g
    | GLeaf => 0
    | GNode(l, x, r) => (let kl = floor(k / 2) in if i < kl then get(l, i, kl) else if i == kl then x else get(r, i - kl - 1, k - kl - 1))
    end in
  let code : (Float, Float) -> Float = fun (c, r) -> if c < 0 || c >= w || r < 0 || r >= h then 0 else get(grid, r * w + c, n) in
  # the best cost found to each tile and the tile it was reached from: a balanced tree (AVL) by place #
  let height : Best -> Float = fun b -> case b | BLeaf => 0 | BNode(_, _, _, _, _, hh) => hh end in
  let node : (Best, Float, Float, Float, Best) -> Best = fun (l, k, g, p, r) -> (let hl = height(l) in let hr = height(r) in BNode(l, k, g, p, r, (if hl > hr then hl else hr) + 1)) in
  let tilt : (Best, Float, Float, Float, Best) -> Best = fun (l, k, g, p, r) ->
    let hl = height(l) in let hr = height(r) in
    if hl > hr + 1 then
      (case l
       | BNode(ll, lk, lg, lp, lr, _) =>
         if height(ll) >= height(lr) then node(ll, lk, lg, lp, node(lr, k, g, p, r))
         else (case lr
           | BNode(lrl, lrk, lrg, lrp, lrr, _) => node(node(ll, lk, lg, lp, lrl), lrk, lrg, lrp, node(lrr, k, g, p, r))
           | BLeaf => node(l, k, g, p, r)
           end)
       | BLeaf => node(l, k, g, p, r)
       end)
    else if hr > hl + 1 then
      (case r
       | BNode(rl, rk, rg, rp, rr, _) =>
         if height(rr) >= height(rl) then node(node(l, k, g, p, rl), rk, rg, rp, rr)
         else (case rl
           | BNode(rll, rlk, rlg, rlp, rlr, _) => node(node(l, k, g, p, rll), rlk, rlg, rlp, node(rlr, rk, rg, rp, rr))
           | BLeaf => node(l, k, g, p, r)
           end)
       | BLeaf => node(l, k, g, p, r)
       end)
    else node(l, k, g, p, r) in
  let put : (Best, Float, Float, Float) -> Best = fun (b, k, g, p) ->
    case b
    | BLeaf => BNode(BLeaf, k, g, p, BLeaf, 1)
    | BNode(l, key, bg, bp, r, hh) => if k < key then tilt(put(l, k, g, p), key, bg, bp, r) else if k > key then tilt(l, key, bg, bp, put(r, k, g, p)) else BNode(l, k, g, p, r, hh)
    end in
  # the best cost to a tile (-1, none yet) and the tile before it #
  let best : (Best, Float) -> (g = Float, p = Float) = fun (b, k) ->
    case b
    | BLeaf => (g = 0 - 1, p = 0 - 1)
    | BNode(l, key, bg, bp, r, _) => if k < key then best(l, k) else if k > key then best(r, k) else (g = bg, p = bp)
    end in
  # the tiles still to take, least estimate first (a pairing heap): each with its estimate, its place and its cost so far #
  let meld : (Heap, Heap) -> Heap = fun (a, b) ->
    case (a, b)
    | (HE, _) => b
    | (_, HE) => a
    | (HN(fa, ia, ga, ka), HN(fb, ib, gb, kb)) => if fa < fb || (fa == fb && ia < ib) then HN(fa, ia, ga, b :: ka) else HN(fb, ib, gb, a :: kb)
    end in
  let pairs : ([Heap], [Heap]) -> [Heap] = fun (ks, acc) ->
    case ks | [] => acc | x :: more => (case more | [] => x :: acc | y :: rest => pairs(rest, meld(x, y) :: acc) end) end in
  let gather : ([Heap], Heap) -> Heap = fun (hs, acc) -> case hs | [] => acc | x :: rest => gather(rest, meld(x, acc)) end in
  let absi : Float -> Float = fun x -> if x < 0 then 0 - x else x in
  let tc = md(t, w) in let tr = floor(t / w) in
  let guess : Float -> Float = fun i -> 1000 * (absi(md(i, w) - tc) + absi(floor(i / w) - tr)) in
  let avoided : ([Float], Float) -> Bool = fun (xs, i) -> case xs | [] => false | y :: ys => y == i || avoided(ys, i) end in
  # a move into (c2, r2), extra more than going in: the heap and the best costs as they are after it #
  let go : ((heap = Heap, b = Best), Float, Float, Float, Float, Float) -> (heap = Heap, b = Best) = fun (st, from, d, c2, r2, extra) ->
    let e = floor(code(c2, r2) / 8) in
    if e <= 0 then st
    else (let j = r2 * w + c2 in
      if avoided(avoid, j) then st
      else (let nd = d + e + extra in let old = best(st.b, j).g in
        if old >= 0 && nd >= old then st
        else (heap = meld(st.heap, HN(nd + guess(j), j, nd, [])), b = put(st.b, j, nd, from)))) in
  let search : (Heap, Best, Float) -> Best = fun (heap, b, seen) ->
    case heap
    | HE => b
    | HN(_, i, d, kids) =>
      if seen >= limit then b
      else (let rest = gather(pairs(kids, []), HE) in
        if d > best(b, i).g then search(rest, b, seen)
        else if i == t then b
        else (let c = md(i, w) in let r = floor(i / w) in let here = code(c, r) in
          let solid = md(floor(here / 4), 2) == 1 in let climb = md(floor(here / 2), 2) == 1 in let stand = md(here, 2) == 1 in
          let held = climb || stand || solid in
          let s0 = (heap = rest, b = b) in
          let s1 = (if held then go(go(s0, i, d, c - 1, r, 0), i, d, c + 1, r, 0) else s0) in
          let s2 = go(s1, i, d, c, r + 1, 0) in
          let above = code(c, r - 1) in
          let s3 = (if climb || (md(floor(above / 4), 2) == 1 && held) then go(s2, i, d, c, r - 1, 300)
            else if stand then
              (let s4 = go(s2, i, d, c, r - 1, 1500) in
               let up = (r - 1 >= 0 && md(floor(above / 4), 2) == 0) in
               let s5 = (if up && c - 1 >= 0 && md(code(c - 1, r - 1), 2) == 1 then go(s4, i, d, c - 1, r - 1, 1800) else s4) in
               if up && c + 1 < w && md(code(c + 1, r - 1), 2) == 1 then go(s5, i, d, c + 1, r - 1, 1800) else s5)
            else s2) in
          search(s3.heap, s3.b, seen + 1)))
    end in
  let done = search(HN(guess(s), s, 0, []), put(BLeaf, s, 0, 0 - 1), 0) in
  let back : (Float, [Float]) -> [Float] = fun (i, acc) -> if i == s || i < 0 then acc else back(best(done, i).p, i :: acc) in
  if best(done, t).g < 0 then [] else back(t, [])

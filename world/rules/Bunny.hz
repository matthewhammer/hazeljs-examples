# A wild bunny's mind (piece 6 of ^report(64)'s plan, its first part, the bunnies; Gnome world 0.0.141, the page's JavaScript of 0.0.102 moved into Hazel): what a wild bunny does each step, in the meadow round its home. In a hop it goes on along it, and at its end it waits (a moment, or a step if it was running away). Otherwise: the gnome within three and a half tiles of it, not riding Clover, and it runs away from the gnome, a long hop; else it nibbles a while, or waits, or every so often hops a little way about, back toward its home when it has wandered more than five tiles from it. A hop never goes into a river, past the world's edges, or up or down more than a tile and a bit; one that would, it turns round and waits. Its ears prick up now and then. The bunny (b): where it is (x, in tiles), its home, the way it faces, how long it waits, how long it nibbles, its ears, whether it is running away, and its hop (on, from x0 y0 to x1 y1, how far along, t, in how many steps, dur, how high, h). The gnome (g): where it is, and whether it rides. The land round the bunny (w): the height of the land (in tiles) at seven columns from c0, the world's width, and where the rivers near it run (from x0 to x1). The page gives six random numbers from its own stream (r), so the same world goes the same either way: a, the wait after a hop; b, the ears; c, whether to nibble; d, how long; e, which way to wander; f, how far to hop. The answer: the bunny #
let step : ((x = Float, home = Float, face = Int, wait = Int, nib = Int, ear = Float, flee = Bool, hop = (on = Bool, x0 = Float, x1 = Float, y0 = Float, y1 = Float, t = Float, dur = Float, h = Float)), (x = Float, y = Float, riding = Bool), (c0 = Int, ww = Int, land = [Float], rivers = [(x0 = Float, x1 = Float)]), (a = Float, b = Float, c = Float, d = Float, e = Float, f = Float)) -> (x = Float, home = Float, face = Int, wait = Int, nib = Int, ear = Float, flee = Bool, hop = (on = Bool, x0 = Float, x1 = Float, y0 = Float, y1 = Float, t = Float, dur = Float, h = Float)) = fun (b, g, w, r) ->
  let nth : ([Float], Int) -> Float = fun (l, k) ->
    case l
    | [] => 0.
    | y :: rest => (if k == 0 then y else nth(rest, k - 1))
    end in
  let wet : ([(x0 = Float, x1 = Float)], Float) -> Bool = fun (l, x) ->
    case l
    | [] => false
    | v :: rest => (x >=. v.x0 && x <. v.x1) || wet(rest, x)
    end in
  let h = b.hop in
  (if h.on then
    (let t = h.t +. 1. /. h.dur in
     let x = h.x0 +. (h.x1 -. h.x0) *. (if t <. 1. then t else 1.) in
     (if t >=. 1. then
       (x = x, home = b.home, face = b.face, wait = (if b.flee then 1 else 25 + int_of_float(r.a *. 120.)), nib = b.nib, ear = b.ear, flee = b.flee, hop = (on = false, x0 = h.x0, x1 = h.x1, y0 = h.y0, y1 = h.y1, t = t, dur = h.dur, h = h.h))
     else
       (x = x, home = b.home, face = b.face, wait = b.wait, nib = b.nib, ear = b.ear, flee = b.flee, hop = (on = true, x0 = h.x0, x1 = h.x1, y0 = h.y0, y1 = h.y1, t = t, dur = h.dur, h = h.h))))
  else
    (let by = nth(w.land, 3) in
     let dx = b.x -. g.x in
     let dy = by -. g.y in
     let flee = dx *. dx +. dy *. dy <. 12.25 && !g.riding in
     let ear = (if r.b <. 0.006 then 0.45 else (if b.ear -. 0.03 <. 0. then 0. else b.ear -. 0.03)) in
     (if b.nib > 0 && !flee then
       (x = b.x, home = b.home, face = b.face, wait = b.wait, nib = b.nib - 1, ear = ear, flee = flee, hop = h)
     else
       (let wait = (if flee then b.wait else b.wait - 1) in
        (if !flee && wait > 0 then
          (x = b.x, home = b.home, face = b.face, wait = wait, nib = b.nib, ear = ear, flee = flee, hop = h)
        else (if !flee && r.c <. 0.45 then
          (x = b.x, home = b.home, face = b.face, wait = 40, nib = 60 + int_of_float(r.d *. 100.), ear = ear, flee = flee, hop = h)
        else
          (let off = b.x -. b.home in
           let away = (if flee then (if b.x >=. g.x then 1 else 0 - 1)
                       else (if (if off <. 0. then 0. -. off else off) >. 5. then (if off <. 0. then 1 else 0 - 1)
                       else (if r.e <. 0.5 then 0 - 1 else 1))) in
           let to = b.x +. float_of_int(away) *. (if flee then 1.5 +. r.f *. 0.8 else 0.5 +. r.f *. 0.7) in
           let c = int_of_float(to) in
           let land = nth(w.land, c - w.c0) in
           let rise = land -. by in
           (if c > 1 && c < w.ww - 2 && !wet(w.rivers, to) && (if rise <. 0. then 0. -. rise else rise) <. 1.3 then
             (x = b.x, home = b.home, face = away, wait = wait, nib = b.nib, ear = ear, flee = flee, hop = (on = true, x0 = b.x, x1 = to, y0 = by, y1 = land, t = 0., dur = (if flee then 16. else 22.), h = (if flee then 0.9 else 0.45)))
           else
             (x = b.x, home = b.home, face = 0 - away, wait = 40, nib = b.nib, ear = ear, flee = flee, hop = h)))))))))

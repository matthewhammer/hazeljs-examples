# Gnome world (Matthew, 2026-11-23: "a new variation of gnome dig ... called gnome world"): a world thirty-two screens across and thirteen down, from the deep rock up to the tops of great trees, planned here by chance from a seed: the lie of the land, the layers of rock under it and where the water stands in them, the creeks, the stream and the river, the beavers and their lodges and dams, the gnomes' village deep under a hill and its rooms and what is in them, the great trees and the houses on their limbs, in sixteen styles; and each beaver's mind, and how high its dam holds the water. The page moves the gnome, the water and the falling boulders, and draws it all #
let md : (Int, Int) -> Int = fun (a, b) -> a - (a / b) * b;
let next : Int -> Int = fun s -> md(s * 48271 + 11, 2147483647);
let absi : Int -> Int = fun v -> if v < 0 then 0 - v else v;
# a number from 0 to 999 for the seed and k, the same each time #
let hash : (Int, Int) -> Int = fun (s, k) -> md(next(next(md(s * 7919 + k * 104729 + 17, 2147483647))) / 7, 1000);
let cat : ([Place], [Place]) -> [Place] = fun (a, b) -> case a | [] => b | x :: rest => x :: cat(rest, b) end;
let has : ([Int], Int) -> Bool = fun (l, v) -> case l | [] => false | x :: rest => x == v || has(rest, v) end;
# ---- The land ---- #
# the surface's row at column x: 120, less the land's gentle waves, a hill over the village (round column 146), and the hills rising to the east #
let rise : (Int, Int) -> Int = fun (seed, x) ->
  let wave = (hash(seed, x / 32) - 500) * 5 / 1000 + (hash(seed + 1, x / 8) - 500) * 2 / 1000 in
  let hill = (let d = absi(x - 146) in if d < 30 then (30 - d) / 4 else 0) in
  let hills = (if x > 660 then (x - 660) / 20 + (hash(seed + 2, x / 16) - 500) * 4 / 1000 else 0) in
  120 - wave - hill - hills;
let samples : (Int, Int) -> [Int] = fun (seed, i) -> if i > 112 then [] else rise(seed, i * 8) :: samples(seed, i + 1);
# a layer's thickness at every 16th column, from lo to hi tiles #
let thick : (Int, Int, Int, Int, Int) -> [Int] = fun (seed, k, lo, hi, i) -> if i > 56 then [] else (lo + md(hash(seed + k * 13, i), hi - lo + 1)) :: thick(seed, k, lo, hi, i + 1);
# n places of a kind, by chance, as the spec says #
let scatter : (Int, Spec, Int) -> [Place] = fun (seed, sp, i) ->
  if i >= sp.n then [] else
  let r : Int -> Int = fun k -> hash(seed + sp.kind * 1009 + i * 31, k) in
  (kind = sp.kind, x = sp.x0 + md(r(1), sp.xr), y = sp.y0 + md(r(2), sp.yr), w = sp.w0 + md(r(3), sp.wr), h = sp.h0 + md(r(4), sp.hr), v = sp.v0 + md(r(5), sp.vr)) :: scatter(seed, sp, i + 1);
# ---- The kinds of ground ---- #
# Dug and porous: soil, sand and gravel (fast for water), sandstone (slow); dug and not porous: clay, shale (water stands on them: a bowl of clay holds it); not dug, porous: limestone, cracked, water going down through it; not dug, not porous: granite, and the gnomes' masonry and timber #
let ground : Int -> Ground = fun k ->
  if k == 1 then (kind = 1, name = "soil", dig = 10, pores = 45, flow = 10, cling = 30, color = 8014372)
  else if k == 2 then (kind = 2, name = "clay", dig = 18, pores = 0, flow = 0, cling = 0, color = 10510154)
  else if k == 3 then (kind = 3, name = "sand and gravel", dig = 6, pores = 35, flow = 35, cling = 8, color = 12755819)
  else if k == 4 then (kind = 4, name = "sandstone", dig = 26, pores = 22, flow = 5, cling = 15, color = 13141850)
  else if k == 5 then (kind = 5, name = "shale", dig = 34, pores = 0, flow = 0, cling = 0, color = 5988198)
  else if k == 6 then (kind = 6, name = "limestone", dig = 0, pores = 15, flow = 18, cling = 10, color = 13617848)
  else if k == 7 then (kind = 7, name = "granite", dig = 0, pores = 0, flow = 0, cling = 0, color = 9078152)
  else if k == 8 then (kind = 8, name = "masonry", dig = 0, pores = 0, flow = 0, cling = 0, color = 10260352)
  else if k == 9 then (kind = 9, name = "timber", dig = 0, pores = 0, flow = 0, cling = 0, color = 9133611)
  else (kind = 0, name = "air", dig = 0, pores = 100, flow = 900, cling = 0, color = 0);
# (Matthew: "let's give more power ups in gnome world: * good digger * super digger. They speed up the digging through tough rock, and permit digging into bedrock") The steps it takes to dig a tile of ground w in row r, with the gnome's digger (0 none, 1 the good digger, 2 the super digger); 0, it cannot be dug. With none, the ground as its kind says: soil, clay, sand and gravel, sandstone, shale. The good digger digs the tough ones (clay, sandstone, shale) in two thirds the time, and the rock too: limestone, and granite, slowly. The super digger digs everything in a third the time (four steps at least), and the bedrock: the granite under the world, its last four rows, all but the very last. Never the gnomes' masonry nor timber (0.0.102, Matthew: "let's increase the speed of the digger power ups each by 3x": each digger a third of the steps it took) #
let dig_steps : (Int, Int, Int) -> Int = fun (w, r, tool) ->
  if w < 1 || w > 7 || r >= 207 then 0
  else if tool <= 0 then ground(w).dig
  else if tool == 1 then (if w == 6 then 16 else if w == 7 then (if r >= 204 then 0 else 24) else (let d = ground(w).dig in if d >= 18 then d * 2 / 9 else (if d < 6 then 2 else d / 3)))
  else if w == 6 then 5 else if w == 7 then (if r >= 204 then 12 else 8) else (let q = ground(w).dig / 9 in if q < 1 then 1 else q);
# ---- The plan ---- #
# The world from its seed: the rivers first (the creek, the river, the stream, a creek in the hills), each its water four rows under the land (room for a dam to raise it); the beavers' lodges and dams on the river and the stream, three beavers and two; the three great trees (ladders, a stair inside, ladders); the village under the hill and a hamlet past the river; the trees, thick in the forest and by the water (willows and aspens there, which the beavers fell), pines in the hills, none in the water, by a great tree or at a door; bushes; and under the ground, by chance, bowls of clay, beds of old river gravel, shelves of limestone with caves, bodies of granite, veins of gems and boulders #
let plan : Int -> Plan = fun seed ->
  let j : Int -> Int = fun k -> md(hash(seed, 200 + k), 9) - 4 in
  let river : (Int, Int, Int, Int) -> Place = fun (kind, x, w, h) -> (kind = kind, x = x, y = rise(seed, x + w / 2) + 4, w = w, h = h, v = 0) in
  let creek = river(10, 240 + j(1), 3, 2) in
  let big = river(12, 424 + j(2), 20, 7) in
  let stream = river(11, 600 + j(3), 9, 4) in
  let creek2 = river(10, 808 + j(4), 4, 2) in
  let rivers = [creek, big, stream, creek2] in
  let lodge1 = big.x + big.w - 6 in
  let lodge2 = stream.x - 4 in
  let dam1 = big.x + big.w / 2 in
  let dam2 = stream.x + stream.w / 2 in
  let beavers = [(kind = 13, x = lodge1, y = big.y, w = 5, h = 3, v = 0), (kind = 14, x = big.x, y = big.y, w = big.w, h = big.h, v = 2),
                 (kind = 15, x = lodge1 + 2, y = 0, w = dam1, h = 0, v = 0), (kind = 15, x = lodge1 + 2, y = 0, w = dam1, h = 0, v = 1), (kind = 15, x = lodge1 + 2, y = 0, w = dam1, h = 0, v = 2),
                 (kind = 13, x = lodge2, y = stream.y, w = 4, h = 3, v = 1), (kind = 14, x = stream.x, y = stream.y, w = stream.w, h = stream.h, v = 1),
                 (kind = 15, x = lodge2 + 2, y = 0, w = dam2, h = 0, v = 3), (kind = 15, x = lodge2 + 2, y = 0, w = dam2, h = 0, v = 4)] in
  let g1 = 68 + j(5) in let g2 = 332 + j(6) in let g3 = 728 + j(7) in
  let greats = [(kind = 30, x = g1, y = rise(seed, g1), w = 3, h = 90, v = hash(seed, 301)),
                (kind = 31, x = g2, y = rise(seed, g2), w = 5, h = 102, v = hash(seed, 302)),
                (kind = 30, x = g3, y = rise(seed, g3), w = 3, h = 84, v = hash(seed, 303))] in
  let hamlet = 508 + j(8) in
  let villages = [(kind = 20, x = 124, y = 126, w = 40, h = 24, v = 4), (kind = 21, x = hamlet, y = 130, w = 26, h = 12, v = 2)] in
  let blocked : Int -> Bool = fun x -> (let in_water : [Place] -> Bool = fun ps -> case ps | [] => false | p :: rest => (x >= p.x - 2 && x <= p.x + p.w + 1) || in_water(rest) end in
    in_water(rivers) || absi(x - g1) < 16 || absi(x - g2) < 18 || absi(x - g3) < 16 || (x >= 120 && x <= 128) || (x >= hamlet - 4 && x <= hamlet + 3)) in
  let wet : Int -> Bool = fun x -> (let close : [Place] -> Bool = fun ps -> case ps | [] => false | p :: rest => (x >= p.x - 20 && x <= p.x + p.w + 20) || close(rest) end in close(rivers)) in
  let species : Int -> Int = fun x -> (let r = hash(seed, 700 + x) in if wet(x) then (if md(r, 2) == 0 then 4 else 3) else if x > 660 then (if md(r, 3) == 0 then 2 else 1) else md(r, 3)) in
  let trees : Int -> [Place] = fun x -> if x >= 894 then [] else
    (let r = hash(seed, 600 + x) in
     let dense = (if wet(x) then 700 else if x >= 256 && x <= 410 then 650 else 300) in
     if r < dense && !blocked(x) then (kind = 50, x = x, y = 0, w = 1, h = 18 + md(r, 13), v = species(x)) :: trees(x + 10 + md(r / 3, 7)) else trees(x + 3 + md(r / 3, 3))) in
  let bushes : Int -> [Place] = fun x -> if x >= 894 then [] else
    (let r = hash(seed, 800 + x) in if r < 260 && !blocked(x) then (kind = 51, x = x, y = 0, w = 1, h = 1, v = md(r, 3)) :: bushes(x + 10 + md(r, 8)) else bushes(x + 4)) in
  let flowers : Int -> [Place] = fun x -> if x >= 894 then [] else
    (let r = hash(seed, 1300 + x) in if r < (if wet(x) then 300 else 560) && !blocked(x) then (kind = 54, x = x, y = 0, w = 1, h = 1 + md(r, 3), v = md(r / 3, 5)) :: flowers(x + 2 + md(r, 3)) else flowers(x + 1)) in
  let shrooms : Int -> [Place] = fun x -> if x >= 894 then [] else
    (let r = hash(seed, 1100 + x) in if r < (if x >= 256 && x <= 410 then 300 else 120) && !blocked(x) then (kind = 53, x = x, y = 0, w = 1, h = 1, v = md(r, 2)) :: shrooms(x + 4 + md(r, 5)) else shrooms(x + 3)) in
  let under = cat(scatter(seed, (kind = 40, n = 16, x0 = 8, xr = 878, y0 = 128, yr = 14, w0 = 8, wr = 7, h0 = 4, hr = 3, v0 = 0, vr = 1), 0),
              cat(scatter(seed, (kind = 41, n = 12, x0 = 0, xr = 878, y0 = 136, yr = 16, w0 = 14, wr = 13, h0 = 2, hr = 2, v0 = 0, vr = 1), 0),
              cat(scatter(seed, (kind = 42, n = 10, x0 = 10, xr = 858, y0 = 158, yr = 20, w0 = 18, wr = 17, h0 = 6, hr = 5, v0 = 0, vr = 1000), 0),
              cat(scatter(seed, (kind = 43, n = 16, x0 = 0, xr = 888, y0 = 176, yr = 22, w0 = 6, wr = 10, h0 = 4, hr = 5, v0 = 0, vr = 1), 0),
              cat(scatter(seed, (kind = 44, n = 24, x0 = 4, xr = 888, y0 = 124, yr = 18, w0 = 3, wr = 1, h0 = 3, hr = 1, v0 = 3, vr = 4), 0),
              cat(scatter(seed + 5, (kind = 44, n = 44, x0 = 4, xr = 888, y0 = 140, yr = 60, w0 = 3, wr = 1, h0 = 3, hr = 1, v0 = 4, vr = 6), 0),
                  scatter(seed, (kind = 45, n = 72, x0 = 4, xr = 888, y0 = 124, yr = 60, w0 = 1, wr = 1, h0 = 1, hr = 1, v0 = 0, vr = 1), 0))))))) in
  let table : Int -> [Int] = fun i -> if i > 56 then [] else (154 + md(hash(seed, 900 + i), 9) - 4) :: table(i + 1) in
  (seed = seed, surface = samples(seed, 0),
   layers = [(kind = 1, thick = thick(seed, 1, 3, 5, 0)), (kind = 2, thick = thick(seed, 2, 0, 3, 0)), (kind = 4, thick = thick(seed, 3, 5, 11, 0)),
             (kind = 5, thick = thick(seed, 4, 2, 6, 0)), (kind = 3, thick = thick(seed, 5, 0, 3, 0)), (kind = 4, thick = thick(seed, 6, 6, 12, 0)),
             (kind = 5, thick = thick(seed, 7, 3, 7, 0)), (kind = 4, thick = thick(seed, 8, 8, 16, 0)), (kind = 2, thick = thick(seed, 9, 1, 4, 0)),
             (kind = 4, thick = thick(seed, 10, 40, 40, 0))],
   table = table(0),
   places = cat(rivers, cat(beavers, cat(greats, cat(villages, cat(trees(2), cat(bushes(5), cat(shrooms(3), cat(flowers(1), under)))))))));
# ---- The gnomes' houses, deep under the ground ---- #
# A village's rooms (which 0, the village: four floors; 1, a hamlet: two): each floor six rows under the one above, its rooms side by side eastward from the stair (columns x0 to x0 + 2, a ladder down from the door), a wall between each; the kitchens, the sitting room and the workshop with a chimney, the hall, the library and the nursery with a light shaft, the dining room, the bedrooms and the bath house with an air shaft #
let village : (Int, Int, Int, Int) -> [Room] = fun (x0, top, which, seed) ->
  let kinds : Int -> [Int] = fun f -> if which == 1 then (if f == 0 then [0, 1, 2] else [9, 3, 11]) else
    (if f == 0 then [0, 1, 6, 3] else if f == 1 then [10, 5, 2, 12] else if f == 2 then [4, 7, 9, 8] else [11, 2, 3]) in
  let floors = (if which == 1 then 2 else 4) in
  let up : Int -> Int = fun k -> if k == 1 || k == 10 || k == 4 then 3 else if k == 0 || k == 5 || k == 12 then 1 else if k == 6 || k == 2 || k == 7 then 2 else 0 in
  let width : (Int, Int) -> Int = fun (k, i) -> (if k == 0 || k == 3 || k == 9 then 6 else if k == 1 || k == 4 || k == 10 then 9 else 8) + md(hash(seed, k * 7 + i), 3) - 1 in
  let row : ([Int], Int, Int, Int) -> [Room] = fun (ks, x, y, i) -> case ks | [] => [] | k :: rest => (let w = width(k, i) in (kind = k, x = x, y = y, w = w, h = 4, up = up(k)) :: row(rest, x + w + 1, y, i + 1)) end in
  let both : ([Room], [Room]) -> [Room] = fun (a, b) -> case a | [] => b | r :: rest => r :: both(rest, b) end in
  let go : Int -> [Room] = fun f -> if f >= floors then [] else both(row(kinds(f), x0 + 3, top + f * 6, f * 10), go(f + 1)) in
  go(0);
# What stands in a room of each kind, all made without electricity (the page draws each): 1 a bed, 2 a table, 3 a chair, 4 a hearth, 5 a wood stove, 6 a shelf of jars, 7 a barrel, 8 an anvil, 9 bellows, 10 a workbench, 11 a bookcase, 12 a writing desk and candle, 13 a wooden tub, 14 a hand pump, 15 a washstand, 16 a bed of mushrooms, 17 a loom, 18 a spinning wheel, 19 a butter churn, 20 a pendulum clock, 21 a rocking chair, 22 an icebox, 23 a rug, 25 a cradle, 26 a chest, 27 a well with its crank, 28 a fern in a pot, 29 a tapestry, 30 a long table and benches, 31 a stone sink and bucket, 32 a pedal grindstone, 33 a globe, 34 a kettle on its hook, 35 pegs and cloaks, 36 bunk beds; each with its width in tenths of a tile #
let stuff : Int -> [Thing] = fun k ->
  let t : (Int, Int) -> Thing = fun (kind, w) -> (kind = kind, at = 0, w = w) in
  if k == 0 then [t(35, 9), t(26, 10), t(20, 6), t(28, 5)]
  else if k == 1 then [t(4, 14), t(34, 6), t(2, 14), t(3, 5), t(31, 10), t(22, 8), t(19, 5), t(6, 10)]
  else if k == 2 then [t(1, 18), t(15, 7), t(26, 9), t(21, 8), t(29, 8)]
  else if k == 3 then [t(7, 7), t(7, 7), t(6, 12), t(6, 12), t(26, 9)]
  else if k == 4 then [t(9, 7), t(4, 12), t(8, 8), t(10, 16), t(32, 8)]
  else if k == 5 then [t(11, 10), t(12, 12), t(3, 5), t(11, 10), t(33, 5)]
  else if k == 6 then [t(30, 26), t(20, 6), t(6, 10)]
  else if k == 7 then [t(5, 10), t(13, 16), t(14, 6), t(15, 7)]
  else if k == 8 then [t(16, 14), t(16, 14), t(7, 7)]
  else if k == 9 then [t(27, 14), t(14, 6), t(7, 7), t(31, 10)]
  else if k == 10 then [t(4, 14), t(21, 8), t(23, 20), t(18, 9), t(29, 8)]
  else if k == 11 then [t(17, 16), t(18, 9), t(26, 9), t(28, 5)]
  else [t(25, 9), t(36, 16), t(28, 5), t(29, 8)];
# a room's things, as many as fit in its width (w tiles) less a little, spread evenly across it #
let furnish : (Int, Int) -> [Thing] = fun (k, w) ->
  let room = w * 10 - 4 in
  let fit : ([Thing], Int) -> [Thing] = fun (l, used) -> case l | [] => [] | x :: rest => if used + x.w > room then [] else x :: fit(rest, used + x.w + 2) end in
  let total : [Thing] -> Int = fun l -> case l | [] => 0 | x :: rest => x.w + total(rest) end in
  let count : [Thing] -> Int = fun l -> case l | [] => 0 | _ :: rest => 1 + count(rest) end in
  let these = fit(stuff(k), 0) in
  let gap = (w * 10 - total(these)) / (count(these) + 1) in
  let place : ([Thing], Int) -> [Thing] = fun (l, at) -> case l | [] => [] | x :: rest => (kind = x.kind, at = at + gap, w = x.w) :: place(rest, at + gap + x.w) end in
  place(these, 0);
# ---- The great trees ---- #
# A great tree's limbs (kind 30, with ladders; 31, a stair inside its trunk), h tall: the first nine rows up, then every four or five, side to side, up to five rows from its top; seven in ten end in a tree house of one of the sixteen styles, the rest in a bird house or a squirrel's house; on the stair tree, two limbs in three have a rope bridge across to the next one up #
let limbs : (Int, Int, Int) -> [Limb] = fun (kind, h, seed) ->
  let go : (Int, Int, Int) -> [Limb] = fun (y, side, i) ->
    if y > h - 5 then [] else
    (let r = hash(seed, i) in
     let pick = md(r / 10, 10) in
     (y = y, side = side, len = 6 + md(r, 7), house = (if pick < 7 then md(hash(seed, i + 50), 16) else if pick < 9 then 100 else 101), bridge = kind == 31 && md(r / 100, 3) != 0) :: go(y + 7 + md(r / 7, 4), 0 - side, i + 1)) in
  go(22, (if md(seed, 2) == 0 then 1 else 0 - 1), 0);
# The sixteen styles of tree house, gnome-made in the craftsman way: low or steep gables with rafter tails and braces, shingles, divided windows, tapered posts; each its own roof, colors, walls (shingled, boarded, of logs, half-timbered, of stone, of birch bark, plastered), windows and one thing more #
let styles : [Style] = [
  (name = "Mushroom Lodge", latin = "Domus Fungorum", roof = 3, walls = 15391160, roofc = 12597547, trim = 7029286, clad = 3, win = 1, more = 4),
  (name = "Oak Bungalow", latin = "Casa Quercina", roof = 0, walls = 9410425, roofc = 5978665, trim = 15852486, clad = 4, win = 2, more = 1),
  (name = "Acorn Cottage", latin = "Casula Glandis", roof = 4, walls = 13214315, roofc = 7228202, trim = 4074008, clad = 2, win = 3, more = 8),
  (name = "Owl's Watch", latin = "Specula Noctuae", roof = 5, walls = 8022613, roofc = 4148794, trim = 15253872, clad = 1, win = 1, more = 3),
  (name = "Moss Gable", latin = "Tectum Muscosum", roof = 1, walls = 10506797, roofc = 5143866, trim = 15722194, clad = 0, win = 0, more = 9),
  (name = "Pinecone Villa", latin = "Villa Pinea", roof = 2, walls = 7311218, roofc = 8079917, trim = 14272931, clad = 1, win = 2, more = 2),
  (name = "Thatch Nook", latin = "Tugurium Stramineum", roof = 8, walls = 14205861, roofc = 13150545, trim = 6111287, clad = 3, win = 3, more = 8),
  (name = "Star Gazer", latin = "Speculum Stellarum", roof = 6, walls = 3098712, roofc = 10135989, trim = 15909198, clad = 1, win = 1, more = 7),
  (name = "Bell Loft", latin = "Turris Campanae", roof = 1, walls = 11887901, roofc = 3362392, trim = 16050648, clad = 2, win = 3, more = 6),
  (name = "Honey Hut", latin = "Casa Mellifera", roof = 0, walls = 14922824, roofc = 9198123, trim = 5978654, clad = 0, win = 2, more = 11),
  (name = "Weathervane Workshop", latin = "Officina Ventorum", roof = 7, walls = 9137991, roofc = 4873507, trim = 14734775, clad = 4, win = 0, more = 10),
  (name = "Ivy Porch House", latin = "Domus Hederacea", roof = 2, walls = 14143154, roofc = 3890746, trim = 8015405, clad = 5, win = 0, more = 1),
  (name = "Lantern Library", latin = "Bibliotheca Silvestris", roof = 1, walls = 7162945, roofc = 3033698, trim = 15783308, clad = 3, win = 3, more = 5),
  (name = "Fern Cabin", latin = "Casula Filicum", roof = 0, walls = 5597999, roofc = 9127187, trim = 16113331, clad = 2, win = 2, more = 4),
  (name = "Birch Bower", latin = "Umbraculum Betulae", roof = 7, walls = 15921126, roofc = 6187837, trim = 3092271, clad = 6, win = 0, more = 8),
  (name = "Toadstool Tower", latin = "Turricula Boleti", roof = 3, walls = 16181192, roofc = 13849600, trim = 6111287, clad = 7, win = 1, more = 3)];
# ---- The beavers ---- #
# A beaver's step (ten a second): resting in its lodge until it is time, then off to a pile of logs within 36 tiles of its lodge (piles: the columns of the piles with logs on them), or to a fallen tree there still to be cut up (fallen: their columns), or, neither, to the nearest standing tree there (trees: the standing trees' columns); it gnaws it four seconds, and it falls. (Matthew: "when the beavers carry a tree, they should carry one log at a time, from a huge pile that they create"; "let's have the beavers produce logs from the fallen tree in stages, not instantly", "doing DFS ideally") Then it cuts the fallen tree up, a log every two seconds onto a pile beside it (cut: the page takes the next piece of the tree, depth first); when there is nothing left to cut, it drags a log from the pile to its dam (slower), lays it two seconds, and goes back for the next, cutting more if the pile is empty and the tree is not, until both are gone, and then home to rest. Starting to drag a log (job 3, tree its pile's column) takes it from the pile. A tree, a pile or a fallen tree gone before it gets there (another beaver's), and it goes home #
let beaver : (Beaver, [Int], [Int], [Int]) -> Beaver = fun (b, trees, piles, fallen) ->
  let near : ([Int], Int, Int) -> Int = fun (ts, best, bd) -> case ts | [] => best | t :: rest => (let d = absi(t * 100 - b.x) in if absi(t - b.lodge) <= 36 && d < bd then near(rest, t, d) else near(rest, best, bd)) end in
  let go : (Int, Int) -> Int = fun (to, sp) -> if absi(to - b.x) <= sp then to else if to > b.x then b.x + sp else b.x - sp in
  let face : Int -> Int = fun to -> if to > b.x then 1 else if to < b.x then 0 - 1 else b.face in
  let be : (Int, Int, Int, Int, Int, Int, Bool, Bool) -> Beaver = fun (x, f, job, t, tree, felled, laid, cut) -> (x = x, face = f, job = job, t = t, tree = tree, lodge = b.lodge, dam = b.dam, felled = felled, laid = laid, cut = cut) in
  let none = 0 - 1 in
  let work : Int -> Bool = fun x -> has(piles, x) || has(fallen, x) in
  if b.job == 0 then (if b.t > 0 then be(b.x, b.face, 0, b.t - 1, none, none, false, false) else (let pl = (let p1 = near(piles, none, 1000000) in if p1 >= 0 then p1 else near(fallen, none, 1000000)) in if pl >= 0 then be(b.x, face(pl * 100), 6, 0, pl, none, false, false) else (let tr = near(trees, none, 1000000) in if tr >= 0 then be(b.x, face(tr * 100), 1, 0, tr, none, false, false) else be(b.x, b.face, 0, 60, none, none, false, false))))
  else if b.job == 1 then (if !has(trees, b.tree) then be(b.x, b.face, 5, 0, none, none, false, false) else (let to = b.tree * 100 + (if b.x < b.tree * 100 then 0 - 60 else 60) in if absi(to - b.x) <= 25 then be(to, face(b.tree * 100), 2, 40, b.tree, none, false, false) else be(go(to, 25), face(to), 1, 0, b.tree, none, false, false)))
  else if b.job == 2 then (if !has(trees, b.tree) then be(b.x, b.face, 5, 0, none, none, false, false) else if b.t > 1 then be(b.x, b.face, 2, b.t - 1, b.tree, none, false, false) else be(b.x, b.face, 7, 20, b.tree, b.tree, false, false))
  else if b.job == 7 then (if !has(fallen, b.tree) then (if has(piles, b.tree) then be(b.x, b.face, 3, 0, b.tree, none, false, false) else be(b.x, b.face, 5, 0, none, none, false, false))
    else if b.t > 1 then be(b.x, b.face, 7, b.t - 1, b.tree, none, false, false) else be(b.x, b.face, 7, 20, b.tree, none, false, true))
  else if b.job == 3 then (let to = b.dam * 100 in if absi(to - b.x) <= 15 then be(to, b.face, 4, 20, b.tree, none, false, false) else be(go(to, 15), face(to), 3, 0, b.tree, none, false, false))
  else if b.job == 4 then (if b.t > 1 then be(b.x, b.face, 4, b.t - 1, b.tree, none, false, false) else if work(b.tree) then be(b.x, b.face, 6, 0, b.tree, none, true, false) else be(b.x, b.face, 5, 0, none, none, true, false))
  else if b.job == 6 then (if !work(b.tree) then be(b.x, b.face, 5, 0, none, none, false, false) else (let to = b.tree * 100 + (if b.x < b.tree * 100 then 0 - 50 else 50) in if absi(to - b.x) <= 25 then (if has(piles, b.tree) then be(to, face(b.tree * 100), 3, 0, b.tree, none, false, false) else be(to, face(b.tree * 100), 7, 20, b.tree, none, false, false)) else be(go(to, 25), face(to), 6, 0, b.tree, none, false, false)))
  else (let to = b.lodge * 100 in if absi(to - b.x) <= 30 then be(to, b.face, 0, 80, none, none, false, false) else be(go(to, 30), face(to), 5, 0, none, none, false, false));
# ---- The villagers ---- #
# (Matthew: "let's put a lot of gnome NPCs into the world, and give them a chance to say something friendly to the main char when engaged"; "again, use Rien Poortvliet, but add our own imagination of variations for all villiagers") A villager's name (who: a number of its own; kind: 0 a gnome, 1 a gnome wife, 2 a gnome child) and what it says to the gnome (where: 0 in the village, 1 out on the land, 2 up a great tree, 3 by the water; n: how many times it has spoken). (Matthew: "let's create more NPC text, based on new animals and ideas/items"; "let's not have any duplicate messages (no two NPCs say the same thing)") Each place has its own long list of lines, about its life, the animals and plants, the things to find and how the world works; and of the villagers of a place (count of them), the one ranked rank says only its own lines of that list: the rank-th, the (rank + count)-th, and so on, one after another each time it speaks, so that no two villagers say the same thing #
let greet : (Int, Int, Int, Int, Int, Int) -> Talk = fun (who, kind, where, n, rank, count) ->
  let pick : ([String], Int) -> String = fun (xs, i) -> case xs | [] => "" | x :: rest => if i <= 0 then x else pick(rest, i - 1) end in
  let len : [String] -> Int = fun xs -> case xs | [] => 0 | x :: rest => 1 + len(rest) end in
  let names = (if kind == 1 then ["Mies", "Fenna", "Lotte", "Sanne", "Griet", "Femke", "Anneke", "Neeltje", "Saar", "Dirkje", "Tilde", "Marijke"]
    else if kind == 2 then ["Pip", "Tess", "Bram", "Lotje", "Teun", "Fien", "Wiebe", "Roos"]
    else ["Joost", "Kees", "Wouter", "Hidde", "Rikkert", "Jelle", "Ruud", "Wim", "Brecht", "Ole", "Gerrit", "Tobias", "Klaas", "Evert"]) in
  let here = (if where == 0 then ["Welcome down! The kettle is always on in the kitchen.", "Mind your cap on the low beams.", "The light shafts bring the sun right down to us. Clever, eh?", "We dug these rooms out of the hill, one tile at a time.", "The chimney draws well today. Can you smell the bread?", "The air shafts keep it fresh down here, even in winter.", "Stay for supper! There is mushroom soup.", "My grandmother carved that table, in her three hundredth year.", "The diving gear hangs in the bath house. Breathe under water as long as you like!", "Looking for the good digger? Try the workshop in the hamlet, past the river.", "Granite will not budge for a plain pick. A good digger, though...", "They say the super digger lies deep in a cave in the limestone.", "With the super digger you could dig to the bottom of the world. Nearly.", "The pumps at the foot of the stair keep the cellars dry. Mostly.", "If a room floods, we go up a floor and wait. Patience is a gnome's friend.", "Count your gems! The number at the top says how many the world holds.", "Find every last gem in the world, and there is a party. I have heard the music!", "Five hearts you have. Mind the falling boulders, and your breath under water.", "Faint, and you wake up at home, gems and all. Lucky us.", "I knit socks for the frogs. They never wear them.", "The bees bring us honey, and we leave them the clover.", "A robin came to the hatch this morning, bold as you like.", "The ducks paddle on the river all day. I could never sit so still.", "The swans on the river are proud. Bow to them, and they may nod back.", "Grandfather says the hawk is a friend, as long as you are not a mouse.", "Lotus seeds make a fine soup. Do not tell the frogs.", "Dragonflies were old when the hills were young.", "We store acorns for the squirrels, for a hard winter.", "The library has a book on every kind of rock. Shale is my favourite.", "Sandstone is gritty, clay is sticky, shale comes in sheets. Learn them well!", "Water stands on clay. That is how the ponds under the hill hold.", "Limestone has caves in it, and the caves have gems.", "The beavers are good neighbours, but they do love to chew.", "My cousin lives up in a tree house. Imagine all those ladders!", "The workshop smells of sawdust and pine pitch.", "Our nursery has a cradle made from a walnut shell.", "The mushroom cellar is dark and damp, just as the mushrooms like it.", "The well room is the coolest room in summer.", "We weave cloth from nettles and dye it with berries.", "In the dining room we all sit together, the big ones and the little.", "Three hundred years I have swept this floor. It is very clean.", "Shh, the little ones are napping.", "Wipe your boots, please. The earth gets everywhere.", "A gnome's beard keeps him warm. A gnome wife's braids, too.", "We write down every gem we ever found. The book is very thick.", "Bring me a lotus flower and I will press it in the big book.", "The stair down from the hill has two hundred rungs. I counted.", "When it rains up top, we hear it in the air shafts. A lovely sound.", "Do not dig through our walls, please. Masonry is for keeping.", "Timber beams hold up the floors. Not even a super digger cuts those.", "The fish in the flooded cellars are very well fed.", "I trade honey with the hamlet across the river.", "My pipe and my chair. What more does a gnome need?", "The children race to the hatch to see the first snow.", "On still nights we hear the frogs croaking, all the way down here.", "Have you met the squirrels in the great trees? Fast as lightning.", "Sparrows steal crumbs from our porch. Cheeky birds.", "The blue jay screams, but it means no harm.", "Our bread rises best by the chimney's warm wall.", "Every room has its own lamp, and every lamp its own name.", "Did you know we live for four hundred years?", "Every gnome needs a good lantern.", "The rooms deepest down stay warm, even when the meadow freezes.", "Take care, and come back soon!"]
    else if where == 1 then ["Good day to you, neighbour!", "Lovely weather for a walk in the meadow.", "The flowers lean with the wind. Have you noticed?", "Rain soaks down through the soil, slowly, past the roots.", "Careful on the slopes by the creek. Hold down, and you will slide!", "I am off to gather mushrooms. Not the red ones with white spots!", "Dig a little, and you will find stones in the soil.", "The squirrels are shy, but they are our friends.", "The robins pull worms after the rain. Watch them tug!", "Sparrows hop about in little gangs. Step softly, or off they go.", "Butterflies come to the daisies. The monarchs are the boldest.", "That bumblebee is heavier than it looks. Still it flies!", "Look up: a hawk, circling. It has seen you already.", "When the wind gets up, the leaves come off the trees in a swirl.", "The line at the top tells you what is under your boots, and how wet it is.", "Soil is the softest digging. Clay is slow, and shale is slower.", "A boulder in the ground wobbles before it falls. Stand clear!", "The great trees have houses in them, sixteen styles, they say.", "Climb a great tree's ladders, and the world spreads out below you.", "A tree-climbing pack waits in a tree house. Then any tree is a ladder.", "The beavers fell the willows and aspens by the water. Never the oaks.", "My grandson saw a frog jump three times its length. Or thirty.", "Lupines, poppies, bluebells. I name them all as I walk.", "Planks, bridges, ladders: a bit of wood gets a gnome anywhere.", "Stuck in a pit? Build a ladder, my friend, and climb out.", "The roots under our feet hold the whole hill together.", "When it rains, the soil darkens. The blue shows it is full.", "Hello there, friend!", "They say a gnome is stronger than a horse. Well, a small horse.", "The wind blows harder on the hills. Hold on to your cap!", "Bees know every flower in the meadow by name.", "Off on an adventure? Good luck to you!", "Be kind to the animals, and they will be kind to you.", "Have you seen the dragonflies by the river? Jewels with wings."]
    else if where == 2 then ["What a view from up here!", "Hold the rope when you cross the bridge.", "The ladder sways in the wind. Hold on tight!", "We built our house in the old tree, branch by branch.", "Up here the birds wake us every morning.", "Found the climbing pack yet? Then the whole tree is yours.", "The squirrels live next door. Noisy neighbours!", "A blue jay sits on our railing and scolds us. We scold it back.", "The hawk rests on the very top of this tree some afternoons.", "Sparrows nest under our eaves. We let them.", "When a gale blows, the whole house rocks like a cradle.", "From up here I can see the swans on the river.", "The leaves turn the sunlight green in here.", "Our door was cut from a single slab of bark.", "We have a bird house on the next limb. Always full!", "The stair tree has a staircase inside its trunk. Imagine!", "Walk out along the limb, slowly. It bends, but it holds.", "On a clear day you can count every pond in the valley.", "Robins sing at dawn and at dusk, right outside the window.", "A squirrel stole my acorn cup again. I will get it back.", "We pull water up in a bucket on a rope. Good for the arms!", "The moss on the roof keeps it cool in summer.", "Our house style is very old. Grandmother chose it.", "Don't look down! Or do. It is lovely.", "The jays bury acorns and forget them, and new oaks grow.", "The wind sings in the branches. Listen.", "Up here you hear the frogs from the creek, and the ducks.", "Bridges between the trees, so we can visit without the ground.", "A hawk once took my hat. Brought it back, too, more or less.", "We hang a lantern on every limb for the dark.", "Mind the tree's sway on the ladders. Climb between the gusts.", "Butterflies come up here too, higher than you would think.", "I have lived in this tree since it was a sapling. Well, nearly.", "From our window we watch the beavers at work."]
    else ["The beavers raise the water with every log they lay.", "Water seeps into the ground beside the river.", "Can you swim? Take a deep breath before you dive.", "The beavers cut a fallen tree up branch by branch, then carry the logs one at a time.", "The willows love to have their feet in the water.", "See how the bank slopes down to the water? Easy walking.", "Frogs sit on the lily pads all day and croak. A fine life.", "Come too close and the frog goes plop, under the water.", "Each lily pad has a long stem down to the mud. Pull it, and it pulls back.", "The lotus flowers open pink in the morning. I come every day to see them.", "Lotus seeds sit in a pod like a pepper pot.", "Dragonflies hover, then dart. You cannot catch them. Don't try.", "A frog can catch a dragonfly with its tongue. Quick as a wink!", "The ducks dip their heads and stick their tails up. Dabbling, it is called.", "The drake has a green head; the hen is brown, to hide on her nest.", "The swans glide as if they had no feet at all. They paddle like mad underneath.", "Don't swim too near the swans. They hiss!", "Reeds and bulrushes grow in the shallows. The bulrush has a brown sausage on top.", "Tape grass waves under the water like green ribbons.", "Under the surface, a whole garden: pondweed, milfoil, tape grass.", "Without the diving gear you float at the top. Hold down to dive.", "Watch your bubbles when you dive. When they are gone, so is your breath.", "The diving gear lets you stay under as long as you like.", "Gems lie under the river bed too. Dig sideways as you swim.", "When the beavers' dam grows, the water rises all along the bank.", "The waves get choppy when the wind blows. White caps, even!", "Mangrove roots, my uncle calls them: the tree roots reaching into the water.", "The stream is cold, even in summer. Brr!", "I fish here, but I always put them back.", "The ducks paddle away from me. I must be very scary.", "Listen: quack, quack. And far off, a swan's honk.", "Lily pads float, but don't stand on one. You are no frog.", "The water in the ground is highest by the river.", "Pebbles at the bottom are smooth as eggs from the water."]) in
  let size = len(here) in let c = (if count < 1 then 1 else count) in
  let mine = (if rank < size then (size - 1 - rank) / c + 1 else 0) in
  let i = (if mine > 0 then rank + c * md(n, mine) else md(rank, size)) in
  (name = pick(names, md(who * 7 + 3, len(names))), line = pick(here, i));
# How high a dam holds its river: the water's own row (natural), a row higher for every three logs, but never over the lower bank (its row, bank) #
let water_row : (Int, Int, Int) -> Int = fun (natural, bank, logs) -> (let r = natural - logs / 3 in if r < bank + 1 then bank + 1 else r);
# ---- Roots and mycelium, as Gnome dig's scene grows them (dig/rules/Scene.hz), a segment at a time ---- #
# directions every 10 degrees: 0 to the right, 9 straight down, 18 to the left (y grows downward); their cosines and sines, in thousandths #
let cosines : [Int] = [1000, 985, 940, 866, 766, 643, 500, 342, 174, 0, 0 - 174, 0 - 342, 0 - 500, 0 - 643, 0 - 766, 0 - 866, 0 - 940, 0 - 985, 0 - 1000, 0 - 985, 0 - 940, 0 - 866, 0 - 766, 0 - 643, 0 - 500, 0 - 342, 0 - 174, 0, 174, 342, 500, 643, 766, 866, 940, 985];
let cosd : Int -> Int = fun a -> (let nth : ([Int], Int) -> Int = fun (xs, i) -> case xs | [] => 0 | x :: rest => if i <= 0 then x else nth(rest, i - 1) end in nth(cosines, md(md(a, 36) + 36, 36)));
# (Matthew, 2026-11-23: "the tree roots have regressed, a lot, from the original gnome dig prototype game") From x, y heading a, segments len long and w wide (these two in hundredths of a hundredth of a tile, so that taking a little off each segment, in whole numbers, does not take off a whole unit), n more of them; the lines onto acc. A root (kind 0) wanders a little, is drawn downward a third of the time, grows thinner and shorter, and 30 segments in 100 put out a side root, 30 to 50 degrees off, thinner; a taproot (kind 2) the same, but drawn downward two times in three, so it goes deep, its side roots ordinary roots; a thread of mycelium (kind 1) wanders more, stays as fine all along, and 30 in 100 branch. Each stops at the world's edges, above the ground it starts from (top) and at the rock at the bottom #
let grow : (Int, Int, Int, Int, Int, Int, Int, Int, Int, [Line]) -> [Line] = fun (x, y, a, len, w, n, seed, kind, top, acc) ->
  if n <= 0 || w < 200 || y > (208 - 4) * 100 || y < top || x < 0 || x > 896 * 100 then acc else
  let s1 = next(seed) in
  let wander = (if kind == 1 then md(s1 / 11, 5) - 2 else md(s1 / 11, 3) - 1) in
  let pull = (if (kind == 0 && md(s1 / 13, 3) == 0) || (kind == 2 && md(s1 / 13, 3) != 0) then (if a < 9 then 1 else if a > 9 then 0 - 1 else 0) else 0) in
  let a1 = (let b = a + wander + pull in if b < 1 then 1 else if b > 17 then 17 else b) in
  let x1 = x + cosd(a1) * len / 100000 in let y1 = y + cosd(a1 - 9) * len / 100000 in
  let line = (x0 = x, y0 = y, x1 = x1, y1 = y1, w = w / 100) in
  let side = (if md(s1 / 211, 2) == 0 then 1 else 0 - 1) in
  let acc1 = (if n > 2 && md(s1 / 101, 100) < 30
              then grow(x1, y1, a1 + side * (3 + md(s1 / 307, 3)), len * 8 / 10, (if kind == 1 then w else w * 6 / 10), n / 2, next(s1 + 7), (if kind == 2 then 0 else kind), top, line :: acc)
              else line :: acc) in
  grow(x1, y1, a1, len * (if kind == 1 then 970 else 985) / 1000, (if kind == 1 then w else w * 965 / 1000), n - 1, s1, kind, top, acc1);
# A tree's roots, from its foot (x in hundredths of a tile, the row of the ground it stands on), k its size (Gnome dig's trees 80 to 120; a great tree more): a taproot straight down, as deep as it goes, and six side roots spreading out and down from it, 10, 20 and 40 degrees below level either way; as Gnome dig's, but in segments 1.6 times as long and as many fewer, a world having so many more trees #
let roots : (Int, Int, Int, Int) -> [Line] = fun (x, row, k, seed) ->
  let y = row * 100 + 4 in
  let side : (Int, Int, [Line]) -> [Line] = fun (a, s, l) -> grow(x, y, a, 88 * k, 15 * k, 19, s, 0, y, l) in
  let s1 = next(seed + x) in
  let l0 = grow(x, y, 9, 93 * k, 22 * k, 37, s1, 2, y, []) in
  let l1 = side(1, next(s1 + 1), side(17, next(s1 + 2), l0)) in
  let l2 = side(2, next(s1 + 3), side(16, next(s1 + 4), l1)) in
  side(4, next(s1 + 5), side(14, next(s1 + 6), l2));
# A mushroom's mycelium: seven fine threads spreading out under it, from straight across to straight down #
let threads : (Int, Int, Int) -> [Line] = fun (x, row, seed) ->
  let y = row * 100 + 8 in
  let one : (Int, Int, [Line]) -> [Line] = fun (a, s, l) -> grow(x, y, a, 2400, 300, 14, s, 1, y, l) in
  let s1 = next(seed + x) in
  one(1, next(s1 + 1), one(4, next(s1 + 2), one(7, next(s1 + 3), one(9, next(s1 + 4), one(11, next(s1 + 5), one(14, next(s1 + 6), one(17, next(s1 + 7), [])))))));
# ---- The gnome ---- #
# a tile in the window round the gnome (dc -1 to 1 across, dr -3 to 1 down, from the tile its feet are in), nine bits of it: what is there (0 open, 1 to 7 ground, 8 masonry, 9 timber, 10 a boulder, 11 a platform), 16 its water, 32 whether it can be climbed, and 64 times its shape (0 square, 1 sloping up to the east, 2 sloping up to the west); outside it, open #
let tile : (Near, Int, Int) -> Int = fun (n, dc, dr) ->
  if dc < 0 - 1 || dc > 1 || dr < 0 - 3 || dr > 1 then 0 else
  (let row = (if dr == 0 - 3 then n.r0 else if dr == 0 - 2 then n.r1 else if dr == 0 - 1 then n.r2 else if dr == 0 then n.r3 else n.r4) in
   md(row / (if dc == 0 - 1 then 1 else if dc == 0 then 512 else 262144), 512));
# (Matthew: "let's also do sloped banks, like Mario 3", "more realisitic, especially for creek and stream banks") Where the gnome's middle (x) is over a sloped tile, in the row its feet would be in (y) or the one below, the diagonal there is the ground: it comes down onto it (y below it, the gnome above it the step before), and walking down it stays on it (dashing too: 276 a step, the slope dropping as much under it, so within 300); going up it fast, from one sloped tile into the next one up, it comes onto that too, and off the low end of a slope onto level ground less than 300 below its feet, it steps down onto that (0.0.109); off the top of a slope, onto the ground beside it, it steps up onto that, its top being within 450 of its feet. The ground's height there, or -1 (climbing, or rising) #
let slope_at : (Near, Gnome, Int, Int, Int, Bool, Bool) -> Int = fun (n, g, x, y, vy, climbing, midw) ->
  let at : (Int, Int) -> Int = fun (c, r) -> tile(n, c - n.cx, r - n.cy) in
  let shape : (Int, Int) -> Int = fun (c, r) -> md(at(c, r) / 64, 4) in
  let c = x / 1000 in let f = (y - 1) / 1000 in
  let r = (if shape(c, f) > 0 then f else if shape(c, f + 1) > 0 then f + 1 else if g.ground && shape(c, f - 1) > 0 then f - 1 else 0 - 1) in
  if climbing || vy < 0 then 0 - 1
  else if r >= 0 then (let sy = (r + 1) * 1000 - (if shape(c, r) == 1 then x - c * 1000 else 1000 - (x - c * 1000)) in
    if (y > sy && g.y <= sy + 300) || (g.ground && !midw && y < sy && sy - y < 300) then sy else 0 - 1)
  else (let w = md(at(c, f), 16) in if g.ground && w >= 1 && w <= 10 && y - f * 1000 <= 450 then f * 1000 else if g.ground && !midw && (f + 1) * 1000 - y < 300 && md(at(c, f + 1), 16) >= 1 && md(at(c, f + 1), 16) <= 10 then (f + 1) * 1000 else 0 - 1);
# (Matthew: "down on a slope shouldn't dig --- it should do a slide animation that accelerates, like mario 3") Down held, standing on a slope: the gnome slides down it, faster every step (14 more, up to 190, twice its run); off the slope, still down held, it coasts on, slowing (a sixteenth a step), while it is still faster than it can run. Its speed across, or -100000: not sliding #
let slide_vx : (Near, Gnome, Pad, Bool, Bool) -> Int = fun (n, g, p, climbing, midw) ->
  let shape : (Int, Int) -> Int = fun (c, r) -> md(tile(n, c - n.cx, r - n.cy) / 64, 4) in
  let cx = g.x / 1000 in let feet = (g.y - 1) / 1000 in
  let k = (let a = shape(cx, feet) in if a > 0 then a else shape(cx, feet + 1)) in
  let way = (if k == 1 then 0 - 1 else if k == 2 then 1 else 0) in
  if !p.down || p.dig || !g.ground || climbing || midw then 0 - 100000
  else if way != 0 then (let v = g.vx + way * 14 in if v > 190 then 190 else if v < 0 - 190 then 0 - 190 else v)
  else if absi(g.vx) > 95 then g.vx * 15 / 16 else 0 - 100000;
# (Matthew: "we should also introduce an action button for dig --- on slopes, we don't dig into them, we run across them"; "down can still mean dig"; "but across, on a slope, should mean -- go up/down the slope") The dig button (⛏️): the tile the gnome digs, standing, the way it faces or the way held: with up, the one over its head; with down, the one under it (the sloped tile it stands on, or the ground below); else the one ahead at its feet, else ahead at its head; -1, none #
let dig_ahead : (Near, Gnome, Pad, Int, Int, Int) -> Int = fun (n, g, p, feet, head, up_tile) ->
  let digs : (Int, Int) -> Int = fun (c, r) -> dig_steps(md(tile(n, c - n.cx, r - n.cy), 16), r, g.tool) in
  let cx = g.x / 1000 in let ahead = cx + (if p.dx != 0 then p.dx else g.face) in
  if !p.dig then 0 - 1 else if p.down then (let feet1 = feet + 1 in if md(tile(n, cx - n.cx, feet - n.cy) / 64, 4) > 0 && digs(cx, feet) > 0 then cx * 1000 + feet else if digs(cx, feet1) > 0 then cx * 1000 + feet1 else 0 - 1) else if p.up then (if digs(cx, up_tile) > 0 then cx * 1000 + up_tile else 0 - 1)
  else if digs(ahead, feet) > 0 then ahead * 1000 + feet else if digs(ahead, head) > 0 then ahead * 1000 + head else 0 - 1;
# The second half of the gnome's step (World.step moves it; this, its own function so that neither half nests too deep to build in a browser): what it digs, its breath, what happened, and the gnome as it is now #
let finish : (Gnome, Near, Pad, Moved) -> Gnome = fun (g, n, p, m) ->
  let hh = 880 in let none = 0 - 1 in
  let at : (Int, Int) -> Int = fun (c, r) -> tile(n, c - n.cx, r - n.cy) in
  let digs : (Int, Int) -> Int = fun (c, r) -> dig_steps(md(at(c, r), 16), r, g.tool) in
  let wet : (Int, Int) -> Bool = fun (c, r) -> md(at(c, r) / 16, 2) == 1 in
  let cx = g.x / 1000 in let feet = (g.y - 1) / 1000 in let head = (g.y - hh) / 1000 in
  let midw = wet(cx, (g.y - 450) / 1000) in let headw = wet(cx, (g.y - 800) / 1000) in
  let up_tile = (g.y - hh - 1) / 1000 in
  let climbing = m.climb in let hc = m.hc in
  let dig_up = p.up && (g.ground || climbing || midw) && digs(cx, up_tile) > 0 && g.y - hh - (up_tile + 1) * 1000 < 150 in
  # digging: pushing across into a tile that can be dug (standing, climbing or (Matthew: "when I'm swimming I should be able to dig sideways") swimming), down into the one underfoot (standing or climbing), or up into the one over its head #
  let side = (if p.dx != 0 && !p.dig && hc >= 0 && (g.ground || climbing || midw) then (if digs(hc, feet) > 0 then hc * 1000 + feet else if digs(hc, head) > 0 then hc * 1000 + head else none) else none) in
  # (in the water, the gnome swimming, it digs too: across, down into the tile under its feet, up into the one over its head) #
  let underfoot = feet + 1 in
  # (the dig button, dig_ahead; down still digs, but not a slope: down on a slope slides) #
  let button = dig_ahead(n, g, p, feet, head, up_tile) in
  let target = (if side >= 0 then side
    else if button >= 0 then button
    else if p.down && absi(m.vx) < 40 && md(at(cx, feet) / 64, 4) == 0 && md(at(cx, underfoot) / 64, 4) == 0 && (((g.ground || climbing) && md(g.y, 1000) == 0) || midw) && digs(cx, underfoot) > 0 && underfoot * 1000 - g.y < 150 then cx * 1000 + underfoot
    else if dig_up then cx * 1000 + up_tile else none) in
  let tc = (if target < 0 then none else target / 1000) in
  let tr = (if target < 0 then none else md(target, 1000)) in
  let dt = (if target < 0 then 0 else if tc == g.dc && tr == g.dr then g.dt + 1 else 1) in
  let dug = target >= 0 && dt >= digs(tc, tr) in
  let air = (if headw && !g.gear then g.air - 1 else (let a = g.air + 5 in if a < 600 then a else 600)) in
  let ev = (if dug then 1 else if air <= 0 then 4 else if m.jumped then 2 else if midw && !g.swim && !g.under && g.vy > 30 then 3 else if p.down && g.swim && !g.gear then 5 else 0) in
  (x = m.x, y = m.y, vx = m.vx, vy = m.vy, face = (if p.dx != 0 then p.dx else g.face),
   ground = m.ground, climb = climbing, swim = m.floating || (midw && !headw), under = headw, air = (if air <= 0 then 600 else air), gear = g.gear, tool = g.tool, shoes = g.shoes,
   dc = tc, dr = tr, dt = (if dug then 0 else dt), ev = ev);
# The gnome's step (Matthew, 2026-11-23: "move the gnome in a sub-tile way, so it's not tied to one tile at a time"; "the feel of a platform NES/SNES game"): running (92 thousandths of a tile a step, eased), falling (11 more a step, 267 at most), a jump of two tiles (let go of up and it is cut short), climbing a ladder, the stair or any tunnel dug (70 a step, any way); a box 0.66 of a tile wide and 0.88 tall, stopped by solid tiles, and by a platform only from above (down held: through it). Pushing across into ground that can be dug, standing or climbing, digs it; so does down, standing, into the ground underfoot, and up into the ground just over its head; a tile takes as many steps as its ground and the gnome's digger say (dig_steps). (Matthew: "when the gnome doesn't have the diving suit, we should permit them to swim on the surface. pressing down forces them to start to go under the surface, and starts the air timer") In the water without the diving gear it floats, its head out, and swims across; down held, it dives, slowly; let go, it rises again; up pressed at the surface, a hop out onto the bank. Its head under the water, its breath runs down (600 steps, ten seconds), and comes back five times as fast out of it. With the gear it swims any way, as long as it likes #
let step : (Gnome, Near, Pad) -> Gnome = fun (g, n, p) ->
  let hw = 330 in let hh = 880 in let none = 0 - 1 in
  let mini : (Int, Int) -> Int = fun (a, b) -> if a < b then a else b in
  let maxi : (Int, Int) -> Int = fun (a, b) -> if a > b then a else b in
  let at : (Int, Int) -> Int = fun (c, r) -> tile(n, c - n.cx, r - n.cy) in
  let what : (Int, Int) -> Int = fun (c, r) -> md(at(c, r), 16) in
  # (Matthew: "let's also do sloped banks, like Mario 3", "more realisitic, especially for creek and stream banks") a sloped tile of ground is solid only under its diagonal: the gnome walks up and down it, standing on the diagonal under its middle #
  let shape : (Int, Int) -> Int = fun (c, r) -> md(at(c, r) / 64, 4) in
  let solid : (Int, Int) -> Bool = fun (c, r) -> (let w = what(c, r) in w >= 1 && w <= 10 && shape(c, r) == 0) in
  let wet : (Int, Int) -> Bool = fun (c, r) -> md(at(c, r) / 16, 2) == 1 in
  let climbs : (Int, Int) -> Bool = fun (c, r) -> md(at(c, r) / 32, 2) == 1 in
  let digs : (Int, Int) -> Int = fun (c, r) -> dig_steps(what(c, r), r, g.tool) in
  let cx = g.x / 1000 in
  let feet = (g.y - 1) / 1000 in
  let head = (g.y - hh) / 1000 in
  let midw = wet(cx, (g.y - 450) / 1000) in
  let headw = wet(cx, (g.y - 800) / 1000) in
  let can_climb = climbs((g.x - hw) / 1000, feet) || climbs((g.x + hw) / 1000, feet) || climbs(cx, head) in
  # (in the water, only with up held: so a ladder built in a pit of water climbs out of it) #
  let climbing = can_climb && (!midw || p.up) && (g.climb || p.up || p.down) in
  let floating = midw && !headw && !g.gear && !p.down in
  # the water's surface over the gnome: the top of the highest wet tile above its middle, in the window #
  let top_wet : Int -> Int = fun r -> if r > n.cy - 3 && wet(cx, r - 1) then top_wet(r - 1) else r in
  let surface = top_wet((g.y - 450) / 1000) * 1000 in
  let up_tile = (g.y - hh - 1) / 1000 in
  let dig_up = p.up && (g.ground || climbing || midw) && digs(cx, up_tile) > 0 && g.y - hh - (up_tile + 1) * 1000 < 150 in
  # (Matthew: "a button ... for dashing (instead of walking) --- 3x the speed, where we accelerate up to that speed, but quicker with the running shoes") Dash held (💨, or Shift), already going the way held at a walk (80 or more): on the ground, faster every step, up to three times a walk (276): 5 more a step, or 16 with the running shoes; in the air, its speed kept. Let go of it, and the gnome eases back to a walk #
  let run = (if p.dig then 0 else if p.dash && p.dx != 0 && g.vx * p.dx >= 80 then (if g.ground then p.dx * mini(absi(g.vx) + (if g.shoes then 16 else 5), 276) else g.vx) else g.vx + (p.dx * 92 - g.vx) / 4) in
  # (climbing, or down held standing, with no way across held: eased to the middle of its column, so it fits a shaft one tile wide) #
  let snap = (cx * 1000 + 500 - g.x) / 3 in
  let sv = slide_vx(n, g, p, climbing, midw) in
  let vx = (if sv > 0 - 100000 then sv else if climbing then (if p.dx == 0 || p.dig then snap else p.dx * 70) else if midw then p.dx * (if g.gear then 55 else 58) else if p.dx == 0 && p.down && g.ground then snap else if p.dx == 0 && absi(run) < 8 then 0 else run) in
  let jumped = g.ground && p.jump && !dig_up && !midw && !climbing in
  let vy = (if climbing then (if p.up && !dig_up then 0 - 70 else if p.down then 70 else 0)
    else if midw then
      (if g.gear then (if p.up then 0 - 55 else if p.down then 55 else g.vy * 4 / 5)
       else if p.down then mini(g.vy + 6, 45)
       else if headw then maxi(g.vy * 3 / 4 - 9, 0 - 60)
       else if p.jump then 0 - 160
       else (surface + 480 - g.y) / 4)
    else if jumped then 0 - 208
    else (let v = g.vy + 11 in mini((if !p.up && v < 0 - 70 then 0 - 70 else v), 267))) in
  # across: stopped by a solid tile in the rows the gnome is in #
  let nx0 = g.x + vx in
  # (on a slope, the ground at its top is no wall: within 450 of the gnome's feet, it walks on up onto it; and on a slope rising the way it goes, the ground beyond its high end is level with that, however fast the gnome comes, 0.0.109, for the dash) #
  let sloping = shape(cx, feet) > 0 || shape(cx, feet + 1) > 0 in
  let blocked : Int -> Bool = fun c -> solid(c, head) || (solid(c, feet) && !((shape(cx, feet) == 1 && vx > 0) || (shape(cx, feet) == 2 && vx < 0)) && !(sloping && g.y - feet * 1000 <= 450)) in
  let hc = (if vx > 0 && blocked((nx0 + hw) / 1000) then (nx0 + hw) / 1000 else if vx < 0 && nx0 - hw >= 0 && blocked((nx0 - hw) / 1000) then (nx0 - hw) / 1000 else none) in
  let nx1 = (if hc < 0 then nx0 else if vx > 0 then hc * 1000 - hw - 1 else (hc + 1) * 1000 + hw) in
  let nx = maxi(hw, mini(nx1, 896 * 1000 - hw)) in
  # down: onto a solid tile, or a platform it was above (not with down held); up: its head against a solid tile #
  let l = (nx - hw) / 1000 in let rr = (nx + hw) / 1000 in
  let ny0 = g.y + vy in
  let fr = (ny0 - 1) / 1000 in
  let lands_on : Int -> Bool = fun c -> solid(c, fr) || (what(c, fr) == 11 && !p.down) in
  let land = vy > 0 && g.y <= fr * 1000 && (lands_on(l) || lands_on(rr)) in
  let hr = (ny0 - hh) / 1000 in
  let bump = vy < 0 && (solid(l, hr) || solid(rr, hr)) in
  let ny1 = (if land then fr * 1000 else if bump then (hr + 1) * 1000 + hh else ny0) in
  let sl = slope_at(n, g, nx, ny1, vy, climbing, midw) in
  let ny = (if sl >= 0 then sl else ny1) in
  let below = ny / 1000 in
  let ground_now = sl >= 0 || (md(ny, 1000) == 0 && (solid(l, below) || solid(rr, below) || ((what(l, below) == 11 || what(rr, below) == 11) && !p.down))) in
  finish(g, n, p, (x = nx, y = ny, vx = (if hc >= 0 then 0 else vx), vy = (if land || bump || sl >= 0 then 0 else vy), hc = hc, ground = ground_now, climb = climbing, floating = floating, jumped = jumped))

# A frog's mind (piece 6 of ^report(64)'s plan, its second part, the frogs; Gnome world 0.0.142, the page's JavaScript moved into Hazel): what a frog of the rivers does each step, in view. A frog sits (mode 0) on a lily pad, riding it on the waves, or on the bank; jumps (1) along an arc; or swims (2). In a jump it goes on along the arc, and landing waits a moment. Swimming, it makes for the pad farthest from the gnome (or its bank, a river without pads), and once there, the gnome more than four tiles off, and its wait run out, it jumps up onto it. Sitting: the gnome near (within two and a half tiles, three and a half if the gnome is in the water), it jumps away into the river, and swims; now and then it croaks; a bug just in front of it, its tongue ready, and it eats the bug; its wait run out, on a pad, it jumps to another pad near it, if one is. The frog (f): where it is (x, y, in tiles), its mode, the way it faces, how long it waits, its pad (its place in the river's pads, or -1), and its jump (from x0 y0 to x1 y1, how far along, t, in how many steps, dur, how high, h, and what it does after, into: 0 sit, 2 swim). The gnome (g): where it is (half a tile above its feet), and whether it is in the water. Its river (w): the water's level, where the river starts (rx) and how wide it is (rw); the land under the frog (land); its bank, or where it is if it has none (bank), and the water there (banky); the river's pads, each where it is now on the waves (x, y); the bugs near it (x, y); and whether its tongue is ready (lick). The page gives five random numbers from its own stream (r), so the same world goes the same either way: a, the wait after a jump; b, how far it jumps away; c, whether it croaks; d, the wait on a pad; e, which pad it jumps to. The answer: the frog, whether it croaks, which bug it eats (its place in the list, or -1), and whether it lands in the water near the gnome, for a plop #
let step : ((x = Float, y = Float, mode = Int, face = Int, wait = Int, pad = Int, jump = (x0 = Float, y0 = Float, x1 = Float, y1 = Float, t = Float, dur = Float, h = Float, into = Int)), (x = Float, y = Float, wet = Bool), (level = Float, rx = Float, rw = Float, land = Float, bank = Float, banky = Float, pads = [(x = Float, y = Float)], bugs = [(x = Float, y = Float)], lick = Bool), (a = Float, b = Float, c = Float, d = Float, e = Float)) -> (frog = (x = Float, y = Float, mode = Int, face = Int, wait = Int, pad = Int, jump = (x0 = Float, y0 = Float, x1 = Float, y1 = Float, t = Float, dur = Float, h = Float, into = Int)), croak = Bool, ate = Int, plop = Bool) = fun (f, g, w, r) ->
  let ab : Float -> Float = fun v -> (if v <. 0. then 0. -. v else v) in
  let pad_at : ([(x = Float, y = Float)], Int) -> (x = Float, y = Float) = fun (l, k) ->
    case l
    | [] => (x = 0., y = 0.)
    | p :: rest => (if k == 0 then p else pad_at(rest, k - 1))
    end in
  let count : [(x = Float, y = Float)] -> Int = fun l ->
    case l
    | [] => 0
    | _ :: rest => 1 + count(rest)
    end in
  let far : ([(x = Float, y = Float)], Int, Int, Float) -> Int = fun (l, k, best, d) ->
    case l
    | [] => best
    | p :: rest => (if ab(p.x -. g.x) >. d then far(rest, k + 1, k, ab(p.x -. g.x)) else far(rest, k + 1, best, d))
    end in
  let near : ([(x = Float, y = Float)], Int, Float) -> [Int] = fun (l, k, x) ->
    case l
    | [] => []
    | p :: rest => (if !(k == f.pad) && ab(p.x -. x) <. 2.6 then k :: near(rest, k + 1, x) else near(rest, k + 1, x))
    end in
  let nth : ([Int], Int) -> Int = fun (l, k) ->
    case l
    | [] => 0 - 1
    | i :: rest => (if k == 0 then i else nth(rest, k - 1))
    end in
  let size : [Int] -> Int = fun l ->
    case l
    | [] => 0
    | _ :: rest => 1 + size(rest)
    end in
  let bug : ([(x = Float, y = Float)], Int, Float, Float, Int) -> Int = fun (l, k, x, y, face) ->
    case l
    | [] => 0 - 1
    | b :: rest => (if ab(b.x -. (x +. float_of_int(face) *. 0.5)) <. 0.7 && y -. b.y >. 0. -. 0.2 && y -. b.y <. 1.2 then k else bug(rest, k + 1, x, y, face))
    end in
  let frog : (Float, Float, Int, Int, Int, Int, (x0 = Float, y0 = Float, x1 = Float, y1 = Float, t = Float, dur = Float, h = Float, into = Int)) -> (x = Float, y = Float, mode = Int, face = Int, wait = Int, pad = Int, jump = (x0 = Float, y0 = Float, x1 = Float, y1 = Float, t = Float, dur = Float, h = Float, into = Int)) = fun (x, y, mode, face, wait, pad, jump) ->
    (x = x, y = y, mode = mode, face = face, wait = wait, pad = pad, jump = jump) in
  let dx = f.x -. g.x in
  let dy = f.y -. g.y in
  let d2 = dx *. dx +. dy *. dy in
  let j = f.jump in
  (if f.mode == 1 then
    (let t = j.t +. 1. /. j.dur in
     (if t >=. 1. then
       (frog = frog(j.x1, j.y1, j.into, f.face, 40 + int_of_float(r.a *. 200.), f.pad, (x0 = j.x0, y0 = j.y0, x1 = j.x1, y1 = j.y1, t = t, dur = j.dur, h = j.h, into = j.into)), croak = false, ate = 0 - 1, plop = j.into == 2 && d2 <. 100.)
     else
       (frog = frog(j.x0 +. (j.x1 -. j.x0) *. t, j.y0 +. (j.y1 -. j.y0) *. t -. sin(pi *. t) *. j.h, 1, f.face, f.wait, f.pad, (x0 = j.x0, y0 = j.y0, x1 = j.x1, y1 = j.y1, t = t, dur = j.dur, h = j.h, into = j.into)), croak = false, ate = 0 - 1, plop = false)))
  else (if f.mode == 2 then
    (let n = count(w.pads) in
     let aim = (if n > 0 then far(w.pads, 0, 0, ab(pad_at(w.pads, 0).x -. g.x)) else 0 - 1) in
     let tx = (if aim >= 0 then pad_at(w.pads, aim).x else w.bank) in
     let ty = w.level +. 0.55 in
     let to = tx -. f.x in
     let x = f.x +. (if to >. 0. then 1. else (if to <. 0. then 0. -. 1. else 0.)) *. (if 0.035 <. ab(to) then 0.035 else ab(to)) in
     let y = f.y +. (ty -. f.y) *. 0.08 in
     let face = (if tx >=. f.x then 1 else 0 - 1) in
     (if ab(tx -. x) <. 0.05 && d2 >. 16. && f.wait - 1 <= 0 then
       (frog = frog(x, y, 1, face, f.wait - 1, aim, (x0 = x, y0 = y, x1 = tx, y1 = (if aim >= 0 then pad_at(w.pads, aim).y else w.banky), t = 0., dur = 24., h = 0.6, into = 0)), croak = false, ate = 0 - 1, plop = false)
     else
       (frog = frog(x, y, 2, face, (if ab(tx -. x) <. 0.05 && d2 >. 16. then f.wait - 1 else f.wait), f.pad, j), croak = false, ate = 0 - 1, plop = false)))
  else
    (let on = f.pad >= 0 in
     let p = pad_at(w.pads, f.pad) in
     let x = (if on then p.x else f.x) in
     let y = (if on then p.y else w.land) in
     (if d2 <. (if g.wet then 12.25 else 6.25) then
       (let away = (if x >=. g.x then 1 else 0 - 1) in
        let want = x +. float_of_int(away) *. (0.8 +. r.b *. 0.8) in
        let lo = w.rx +. 0.4 in
        let hi = w.rx +. w.rw -. 0.4 in
        let tx = (if lo >. (if hi <. want then hi else want) then lo else (if hi <. want then hi else want)) in
        (frog = frog(x, y, 1, away, 90, 0 - 1, (x0 = x, y0 = y, x1 = tx, y1 = w.level +. 0.4, t = 0., dur = 26., h = 0.7, into = 2)), croak = false, ate = 0 - 1, plop = false))
     else
       (let croak = r.c <. 0.0035 in
        let ate = (if w.lick then bug(w.bugs, 0, x, y, f.face) else 0 - 1) in
        let wait = f.wait - 1 in
        (if wait <= 0 && on then
          (let others = near(w.pads, 0, x) in
           let m = size(others) in
           (if m > 0 then
             (let k = nth(others, int_of_float(r.e *. float_of_int(m))) in
              let q = pad_at(w.pads, k) in
              (frog = frog(x, y, 1, (if q.x >=. x then 1 else 0 - 1), 300 + int_of_float(r.d *. 600.), k, (x0 = x, y0 = y, x1 = q.x, y1 = q.y, t = 0., dur = 28., h = 0.75, into = 0)), croak = croak, ate = ate, plop = false))
           else
             (frog = frog(x, y, 0, f.face, 300 + int_of_float(r.d *. 600.), f.pad, j), croak = croak, ate = ate, plop = false)))
        else
          (frog = frog(x, y, 0, f.face, wait, f.pad, j), croak = croak, ate = ate, plop = false)))))))
